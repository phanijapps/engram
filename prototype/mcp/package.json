{
  "name": "engram-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "stdio MCP server that exposes Engram as a local tool backend",
  "main": "dist/mcp-stdio.js",
  "bin": {
    "engram-mcp": "dist/mcp-stdio.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/mcp-stdio.ts",
    "build": "tsc",
    "start": "node dist/mcp-stdio.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@engram/node": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
