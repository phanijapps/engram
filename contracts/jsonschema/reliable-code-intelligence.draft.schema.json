{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engram.local/contracts/drafts/reliable-code-intelligence.schema.json",
  "title": "Draft reliable code-intelligence interfaces",
  "$comment": "DRAFT proposal; not accepted v1 or a generated contract. JSON Schema defaults are annotations: shared Rust resolution supplies values. Cross-field/model/token/policy constraints are normative in the linked spec. Runtime enforces cross-field totals, primary classification, pool/threshold/status rules, coverage and 256 KiB packet limit. Scorer provisioning is a separate explicit operation; no runtime download flag.",
  "x-spec": "../../docs/specs/reliable-code-intelligence/spec.md",
  "$ref": "#/$defs/Config",
  "$defs": {
    "Config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1
        },
        "profile": {
          "enum": [
            "balanced-v1",
            "fast-v1"
          ],
          "default": "balanced-v1"
        },
        "index": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "body_token_target": {
              "type": "integer",
              "minimum": 64,
              "maximum": 8192,
              "default": 384
            },
            "context_token_budget": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024,
              "default": 64
            }
          }
        },
        "retrieval": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "candidates_per_lane": {
              "type": "integer",
              "minimum": 10,
              "maximum": 1000,
              "default": 50
            },
            "result_limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            },
            "enabled_lanes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "vector",
                  "lexical",
                  "graph",
                  "associative_graph",
                  "community_summary"
                ]
              },
              "default": [
                "vector",
                "lexical"
              ]
            },
            "graph_hops": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2,
              "default": 1
            },
            "graph_neighbor_limit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "default": 20
            }
          }
        },
        "fusion": {
          "allOf": [
            {
              "$ref": "../v1/schemas/recall-fusion.schema.json"
            },
            {
              "type": "object",
              "properties": {
                "rerank": {
                  "type": "object",
                  "properties": {
                    "strategy": {
                      "enum": [
                        "none",
                        "cross_encoder"
                      ]
                    }
                  }
                }
              }
            }
          ]
        },
        "local_scorer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model_id": {
              "type": "string",
              "minLength": 1,
              "default": "jinaai/jina-reranker-v1-turbo-en"
            },
            "query_token_limit": {
              "type": "integer",
              "minimum": 16,
              "maximum": 2048,
              "default": 128
            },
            "pair_token_limit": {
              "type": "integer",
              "minimum": 128,
              "maximum": 8192,
              "default": 1024
            },
            "max_candidates": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            },
            "batch_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64,
              "default": 8
            },
            "on_failure": {
              "enum": [
                "degrade",
                "error"
              ],
              "default": "degrade"
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "token_budget": {
              "type": "integer",
              "minimum": 256,
              "maximum": 32768,
              "default": 6000
            },
            "max_supporting_units": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "default": 20
            },
            "max_per_file": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 4
            }
          }
        }
      },
      "description": "Partial overlay. Defaults shown are balanced-v1 annotations; shared profile expansion precedes explicit overrides."
    },
    "Query": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "description": "Runtime enforces at most 16384 UTF-8 bytes before tokenization (schema length is code points)."
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "Runtime enforces at most 2048 UTF-8 bytes before tokenization (schema length is code points)."
        },
        "resultLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "candidatesPerLane": {
          "type": "integer",
          "minimum": 10,
          "maximum": 1000
        },
        "evidenceTokenBudget": {
          "type": "integer",
          "minimum": 256,
          "maximum": 32768
        }
      },
      "required": [
        "query"
      ]
    },
    "SourceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "unitId": {
          "type": "string",
          "minLength": 1
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "representationId": {
          "type": "string",
          "minLength": 1
        },
        "startByte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endByte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "indexedRevision": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "repository",
        "path",
        "unitId",
        "sourceHash",
        "generation",
        "representationId",
        "startByte",
        "endByte",
        "indexedRevision"
      ]
    },
    "Item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parentUnitId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "code"
        },
        "sourceCategory": {
          "const": "implementation"
        },
        "excerpts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExcerptPart"
          },
          "maxItems": 20,
          "minItems": 1
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SegmentEvidence"
          },
          "maxItems": 200,
          "minItems": 1
        },
        "context": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContextFact"
          },
          "maxItems": 20,
          "minItems": 0
        },
        "partial": {
          "type": "boolean"
        },
        "fusionScore": {
          "type": "number"
        },
        "rerankScore": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "parentUnitId",
        "name",
        "kind",
        "sourceCategory",
        "excerpts",
        "segments",
        "context",
        "partial",
        "fusionScore",
        "rerankScore"
      ]
    },
    "Diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "configHash": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "enum": [
            "balanced-v1",
            "fast-v1"
          ]
        },
        "requestedReranker": {
          "enum": [
            "none",
            "cross_encoder"
          ]
        },
        "effectiveReranker": {
          "enum": [
            "none",
            "cross_encoder"
          ]
        },
        "scorerState": {
          "enum": [
            "ready",
            "disabled",
            "unavailable",
            "failed"
          ]
        },
        "scorerManifestId": {
          "type": [
            "string",
            "null"
          ]
        },
        "calibrationState": {
          "enum": [
            "validated",
            "unvalidated"
          ]
        },
        "candidateCounts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          }
        },
        "omittedUnits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "truncated": {
          "type": "boolean"
        },
        "reindexRequired": {
          "type": "boolean"
        },
        "configOrigins": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "queryRepresentationId": {
          "type": "string",
          "minLength": 1
        },
        "phaseMs": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "omittedSegments": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "omittedParents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "scoredPairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "calibrationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "thresholdScoreSpace": {
          "enum": [
            "rrf",
            "cross_encoder",
            null
          ]
        }
      },
      "required": [
        "configHash",
        "profile",
        "requestedReranker",
        "effectiveReranker",
        "scorerState",
        "scorerManifestId",
        "calibrationState",
        "candidateCounts",
        "omittedUnits",
        "truncated",
        "reindexRequired",
        "configOrigins",
        "queryRepresentationId",
        "phaseMs",
        "omittedSegments",
        "omittedParents",
        "scoredPairs",
        "calibrationId",
        "thresholdScoreSpace"
      ]
    },
    "Packet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Item"
          },
          "maxItems": 100
        },
        "evidenceStatus": {
          "enum": [
            "candidates_available",
            "insufficient_evidence"
          ]
        },
        "diagnostics": {
          "$ref": "#/$defs/Diagnostics"
        },
        "sourceFailures": {
          "type": "array",
          "items": {
            "$ref": "../v1/schemas/engram-v1.schema.json#/$defs/RetrievalSourceFailure"
          },
          "maxItems": 100
        },
        "supportingUnits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SupportingUnit"
          },
          "maxItems": 100,
          "minItems": 0
        }
      },
      "required": [
        "items",
        "evidenceStatus",
        "diagnostics",
        "sourceFailures",
        "supportingUnits"
      ]
    },
    "TokenCoverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "codeTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8192
        },
        "contextTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "queryTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2048
        },
        "specialTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "totalTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "truncated": {
          "const": false
        }
      },
      "required": [
        "codeTokens",
        "contextTokens",
        "queryTokens",
        "specialTokens",
        "totalTokens",
        "truncated"
      ]
    },
    "ExcerptPart": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "text": {
          "type": "string",
          "maxLength": 131072
        }
      },
      "required": [
        "source",
        "text"
      ]
    },
    "ContextFact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "path",
            "symbol",
            "signature",
            "parent",
            "import",
            "unresolved_import"
          ]
        },
        "value": {
          "type": "string",
          "maxLength": 8192
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 20,
          "minItems": 1
        }
      },
      "required": [
        "kind",
        "value",
        "sources"
      ]
    },
    "SegmentEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "segmentId": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 20,
          "minItems": 1
        },
        "fusionTraces": {
          "type": "array",
          "items": {
            "$ref": "../v1/schemas/engram-v1.schema.json#/$defs/FusionTrace"
          },
          "maxItems": 10,
          "minItems": 1
        },
        "fusionScore": {
          "type": "number"
        },
        "rerankScore": {
          "type": [
            "number",
            "null"
          ]
        },
        "embeddingInput": {
          "$ref": "#/$defs/TokenCoverage"
        },
        "rerankInput": {
          "anyOf": [
            {
              "$ref": "#/$defs/TokenCoverage"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "segmentId",
        "sources",
        "fusionTraces",
        "fusionScore",
        "rerankScore",
        "embeddingInput",
        "rerankInput"
      ]
    },
    "SupportingUnit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unitId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "code",
            "document"
          ]
        },
        "sourceCategory": {
          "enum": [
            "implementation",
            "test",
            "generated",
            "documentation",
            "unknown"
          ]
        },
        "excerpts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExcerptPart"
          },
          "maxItems": 20,
          "minItems": 1
        },
        "partial": {
          "type": "boolean"
        }
      },
      "required": [
        "unitId",
        "name",
        "kind",
        "sourceCategory",
        "excerpts",
        "partial"
      ]
    }
  }
}
