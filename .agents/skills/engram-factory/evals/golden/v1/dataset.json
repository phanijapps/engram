      "harness": {
        "required_capabilities": [
          "actual_actor_invocation",
          "original_tool_transcript",
          "independent_judge",
          "isolated_filesystem",
          "scripted_owner_channel"
        ],
        "entry_state_setup": "Start before ratified brief. The actor may inspect source and conduct framing, but has no implementation Start. Synthetic owner answers only through the owner channel; do not preload its hidden reply.",
