{
  "name": "engram-repo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "backend": "pnpm --filter prototype-backend dev",
    "backend:start": "pnpm --filter prototype-backend start",
    "mcp": "bash mcp/dev.sh",
    "build": "pnpm run build:native && pnpm -r --if-present build",
    "build:native": "pnpm --filter @engram/node build:native",
    "check": "pnpm run contracts:generate && pnpm run typecheck && pnpm run test",
    "clean": "node tools/scripts/clean-workspace.mjs",
    "contracts:generate": "pnpm --filter @engram/contracts generate",
    "contracts:check-generated": "pnpm run contracts:generate && git diff --exit-code -- packages/contracts/src/generated",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm --filter @engram/node build && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "json-schema-to-typescript": "^16.0.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "undici": "^8.12.2",
      "body-parser": ">=2.4.0",
      "fast-uri": ">=3.1.9",
      "minimatch": "^11.0.1"
    }
  }
}