{
  "$comment": "Golden dataset for engram code-intel + mixed-mission retrieval. Each case is a contract: tool + args + expectations against the RENDERED tool output (text) or parsed JSON (fetch_content). Grading: every expectation must hold; a case fails on first violation. Assertion types: contains, not_contains, empty, not_empty, regex, json_field (path via dotted key into parsed JSON), set_equals_field (regex captures a bracketed list, compared as a set). Known gaps NOT encoded here (asserting them would fail by design): EN-14 nested-parent body loss, EN-13/8 per-edge confidence in navigation output.",
  "cases": [
    {
      "id": "G-EXACT-01",
      "guard": "EN-4: substring injections never claim exact identity",
      "tool": "search",
      "args": {
        "query": "Reviewer",
        "limit": 6
      },
      "expect": [
        {
          "type": "not_contains",
          "value": "[exact-match"
        },
        {
          "type": "contains",
          "value": "_check_reviewer_independence"
        }
      ]
    },
    {
      "id": "G-EXACT-02",
      "guard": "true exact identifier still earns the exact tier",
      "tool": "search",
      "args": {
        "query": "_check_reviewer_independence",
        "limit": 5
      },
      "expect": [
        {
          "type": "contains",
          "value": "_check_reviewer_independence"
        }
      ]
    },
    {
      "id": "G-NOISE-01",
      "guard": "unrelated stopword query returns nothing (no fabricated lanes)",
      "tool": "search",
      "args": {
        "query": "how to quantum grandmaster",
        "limit": 5
      },
      "expect": [
        {
          "type": "empty"
        }
      ]
    },
    {
      "id": "G-NOISE-02",
      "guard": "template words (community) do not resurrect community noise",
      "tool": "search",
      "args": {
        "query": "community overview",
        "limit": 5
      },
      "expect": [
        {
          "type": "empty"
        }
      ]
    },
    {
      "id": "G-NOISE-03",
      "guard": "no disconnected associative residue (raw=0.00 unrelated hits)",
      "tool": "search",
      "args": {
        "query": "tokens",
        "limit": 10
      },
      "expect": [
        {
          "type": "contains",
          "value": "_tokens"
        },
        {
          "type": "not_contains",
          "value": "Facets::iter"
        }
      ]
    },
    {
      "id": "G-RECV-01",
      "guard": "EN-9: unknown-receiver .iter() stays unresolved, never binds Facets::iter",
      "tool": "symbol_context",
      "args": {
        "symbol": "ordinary_collections"
      },
      "expect": [
        {
          "type": "contains",
          "value": "values.iter"
        },
        {
          "type": "not_contains",
          "value": "Facets::iter"
        }
      ]
    },
    {
      "id": "G-ATTRIB-01",
      "guard": "EN-10: callers are the innermost methods, not the test class (aliases now link)",
      "tool": "symbol_context",
      "args": {
        "symbol": "_tokens"
      },
      "expect": [
        {
          "type": "set_equals_field",
          "regex": "callers: \\[([^]]*)\\]",
          "value": [
            "TestModernTokenizer::test_alpha",
            "TestModernTokenizer::test_beta",
            "TestModernTokenizer::test_gamma"
          ]
        }
      ]
    },
    {
      "id": "G-ATTRIB-02",
      "guard": "EN-11: method-level blast radius (eval G14 recall 1.0)",
      "tool": "change_impact",
      "args": {
        "target": "_check_reviewer_independence"
      },
      "expect": [
        {
          "type": "contains",
          "value": "ValidatorRunner::check"
        },
        {
          "type": "contains",
          "value": "test_independent"
        },
        {
          "type": "not_contains",
          "value": "note: no indexed entity"
        }
      ]
    },
    {
      "id": "G-DISCLOSE-01",
      "guard": "bare-name impact over unresolved refs is disclosed",
      "tool": "change_impact",
      "args": {
        "target": "runaway_bare_name"
      },
      "expect": [
        {
          "type": "contains",
          "value": "note: no indexed entity"
        }
      ]
    },
    {
      "id": "G-SQL-01",
      "guard": "EN-15: unknown-extension files are lossless (type TEXT trap)",
      "tool": "fetch_content",
      "args": {
        "path": "src/schema.sql"
      },
      "expect": [
        {
          "type": "json_field",
          "field": "total_bytes",
          "op": "gte",
          "value": 100
        },
        {
          "type": "json_field",
          "field": "truncated",
          "op": "eq",
          "value": false
        },
        {
          "type": "contains",
          "value": "TOP_MARKER"
        },
        {
          "type": "contains",
          "value": "BOTTOM_MARKER"
        },
        {
          "type": "contains",
          "value": "type TEXT,"
        }
      ]
    },
    {
      "id": "G-UND-01",
      "guard": "underscore-prefixed symbols are findable",
      "tool": "search",
      "args": {
        "query": "_norm",
        "limit": 3
      },
      "expect": [
        {
          "type": "contains",
          "value": "_norm"
        }
      ]
    },
    {
      "id": "G-SUPPRESS-01",
      "guard": "ADR-0030: artifact kinds (Module) suppressed by default with explicit hint",
      "tool": "search",
      "args": {
        "query": "src.logic",
        "limit": 3
      },
      "expect": [
        {
          "type": "contains",
          "value": "suppressed by default"
        },
        {
          "type": "not_contains",
          "value": "src.logic \u2014"
        }
      ]
    },
    {
      "id": "G-SUPPRESS-02",
      "guard": "ADR-0030: include_code_artifacts re-admits artifact kinds",
      "tool": "search",
      "args": {
        "query": "src.logic",
        "limit": 3,
        "include_code_artifacts": true
      },
      "expect": [
        {
          "type": "contains",
          "value": "src.logic \u2014"
        }
      ]
    },
    {
      "id": "G-PATH-01",
      "guard": "path-shaped queries auto-include file artifacts (fallback-scanned unknown extensions have no file entity \u2014 known gap)",
      "tool": "search",
      "args": {
        "query": "src/logic.py",
        "limit": 5
      },
      "expect": [
        {
          "type": "contains",
          "value": "src/logic.py"
        }
      ]
    },
    {
      "id": "G-STOPWORD-01",
      "guard": "stopword policy does not break recall on natural queries",
      "tool": "search",
      "args": {
        "query": "how to settle payments",
        "limit": 5
      },
      "expect": [
        {
          "type": "contains",
          "value": "settle"
        }
      ]
    },
    {
      "id": "G-EXT-01",
      "guard": "EN-8 balance: external calls stay visible as evidence (not deleted)",
      "tool": "symbol_context",
      "args": {
        "symbol": "cmd_gate"
      },
      "expect": [
        {
          "type": "contains",
          "value": "json.dumps"
        },
        {
          "type": "contains",
          "value": "sys.exit"
        }
      ]
    },
    {
      "id": "G-DOC-01",
      "guard": "mixed mission: docs remain first-class retrieval citizens",
      "tool": "search",
      "args": {
        "query": "readiness manifest",
        "limit": 3
      },
      "expect": [
        {
          "type": "contains",
          "value": "Readiness"
        }
      ]
    },
    {
      "id": "G-NEST-01",
      "guard": "nested functions are first-class symbols (attribution scope)",
      "tool": "search",
      "args": {
        "query": "inner_review",
        "limit": 3
      },
      "expect": [
        {
          "type": "contains",
          "value": "_check_reviewer_independence::inner_review"
        }
      ]
    },
    {
      "id": "G-REPO-01",
      "guard": "Repository exclusion applies to exact-name injection",
      "tool": "search",
      "args": {
        "query": "_tokens",
        "repository": "different/repo",
        "diagnostics": true,
        "limit": 5
      },
      "expect": [
        {
          "type": "empty"
        },
        {
          "type": "not_contains",
          "value": "_tokens (Function)"
        }
      ]
    },
    {
      "id": "G-REPO-02",
      "guard": "Repository exclusion applies to partial-name injection",
      "tool": "search",
      "args": {
        "query": "Reviewer",
        "repository": "different/repo",
        "diagnostics": true,
        "limit": 6
      },
      "expect": [
        {
          "type": "empty"
        },
        {
          "type": "not_contains",
          "value": "_check_reviewer_independence (Function)"
        }
      ]
    },
    {
      "id": "G-DOC-02",
      "guard": "Successful Doc context is not assessed as failed code discovery",
      "tool": "get_context",
      "args": {
        "focus": "readiness manifest",
        "limit": 5
      },
      "expect": [
        {
          "type": "contains",
          "value": "query shape: Doc"
        },
        {
          "type": "contains",
          "value": "Manifest gate advance evidence lives here."
        },
        {
          "type": "not_contains",
          "value": "Recall found no code entities"
        }
      ]
    },
    {
      "id": "G-RECV-02",
      "guard": "Qualified method callers survive unknown-receiver conservatism (EN-9 positive control)",
      "tool": "change_impact",
      "args": {
        "target": "Facets::iter"
      },
      "expect": [
        {
          "type": "set_equals_field",
          "regex": "callers: \\[([^]]*)\\]",
          "value": [
            "legitimate_facets_iter"
          ]
        },
        {
          "type": "not_contains",
          "value": "ordinary_collections"
        },
        {
          "type": "contains",
          "value": "truncated: false"
        }
      ]
    },
    {
      "id": "G-EXACT-03",
      "guard": "True identifier is the first typed symbol result",
      "tool": "search",
      "args": {
        "query": "_check_reviewer_independence",
        "limit": 5,
        "diagnostics": true
      },
      "expect": [
        {
          "type": "regex",
          "value": "\\A_check_reviewer_independence \\(Function\\) \u2014 [^\\n]*src/logic\\.py \\["
        }
      ]
    },
    {
      "id": "G-PATH-02",
      "guard": "Path query returns the File entity, not merely symbols from that path",
      "tool": "search",
      "args": {
        "query": "src/logic.py",
        "limit": 5,
        "diagnostics": true,
        "include_chunks": false
      },
      "expect": [
        {
          "type": "regex",
          "value": "(?m)^src/logic\\.py \\(File\\) \u2014 "
        }
      ]
    },
    {
      "id": "G-EXT-02",
      "guard": "External calls occupy actual callee edges",
      "tool": "symbol_context",
      "args": {
        "symbol": "cmd_gate"
      },
      "expect": [
        {
          "type": "set_equals_field",
          "regex": "callees: \\[([^]]*)\\]",
          "value": [
            "json.dumps",
            "sys.exit"
          ]
        },
        {
          "type": "contains",
          "value": "truncated: false"
        }
      ]
    },
    {
      "id": "G-SQL-02",
      "guard": "Fallback SQL content is completely lossless (byte-exact)",
      "tool": "fetch_content",
      "args": {
        "path": "src/schema.sql"
      },
      "expect": [
        {
          "type": "json_field",
          "field": "content",
          "op": "eq",
          "value": "-- TOP_MARKER\nCREATE TABLE edges (\n    type TEXT,\n    id INTEGER PRIMARY KEY\n);\nCREATE TABLE nodes (\n    label TEXT\n);\n-- BOTTOM_MARKER\n"
        },
        {
          "type": "json_field",
          "field": "truncated",
          "op": "eq",
          "value": false
        }
      ]
    },
    {
      "id": "G-DISCLOSE-02",
      "guard": "Nonempty unresolved-reference impact retains disclosure",
      "tool": "change_impact",
      "args": {
        "target": "json.dumps"
      },
      "expect": [
        {
          "type": "contains",
          "value": "note: no indexed entity"
        },
        {
          "type": "set_equals_field",
          "regex": "callers: \\[([^]]*)\\]",
          "value": [
            "cmd_gate"
          ]
        },
        {
          "type": "contains",
          "value": "truncated: false"
        }
      ]
    },
    {
      "id": "G-RECALL-01",
      "guard": "General recall retains document evidence",
      "tool": "recall",
      "args": {
        "query": "readiness manifest",
        "limit": 3
      },
      "expect": [
        {
          "type": "contains",
          "value": "[chunk"
        },
        {
          "type": "contains",
          "value": "# Readiness"
        },
        {
          "type": "contains",
          "value": "Manifest gate advance evidence lives here."
        }
      ]
    },
    {
      "id": "G-EXPLORE-01",
      "guard": "Explore retains unresolved receiver evidence without false binding",
      "tool": "explore",
      "args": {
        "query": "ordinary_collections"
      },
      "expect": [
        {
          "type": "contains",
          "value": "[function] ordinary_collections (hop 0)"
        },
        {
          "type": "contains",
          "value": "values.iter (hop 1)"
        },
        {
          "type": "not_contains",
          "value": "Facets::iter"
        }
      ]
    },
    {
      "id": "G-SRC-01",
      "guard": "EN-14/16: default fetch is verbatim on-disk source (nested parents whole)",
      "tool": "fetch_content",
      "args": {
        "path": "src/logic.py"
      },
      "expect": [
        {
          "type": "json_field",
          "field": "source",
          "op": "eq",
          "value": "verbatim"
        },
        {
          "type": "contains",
          "value": "verdict = all"
        },
        {
          "type": "contains",
          "value": "return verdict"
        }
      ]
    },
    {
      "id": "G-SRC-02",
      "guard": "symbol-scoped fetch returns just that symbol",
      "tool": "fetch_content",
      "args": {
        "path": "src/logic.py",
        "symbol": "_check_reviewer_independence"
      },
      "expect": [
        {
          "type": "contains",
          "value": "def _check_reviewer_independence"
        },
        {
          "type": "contains",
          "value": "return verdict"
        },
        {
          "type": "not_contains",
          "value": "class ValidatorRunner"
        }
      ]
    },
    {
      "id": "G-VAR-01",
      "guard": "Variable ENTITY suppressed by default (chunk text remains legal evidence)",
      "tool": "search",
      "args": {
        "query": "MAX_RETRIES",
        "limit": 5,
        "diagnostics": true
      },
      "expect": [
        {
          "type": "not_contains",
          "value": "MAX_RETRIES (Variable)"
        },
        {
          "type": "not_contains",
          "value": "suppressed by default"
        }
      ]
    },
    {
      "id": "G-VAR-02",
      "guard": "Variable entities re-admitted with include_code_artifacts",
      "tool": "search",
      "args": {
        "query": "MAX_RETRIES",
        "limit": 5,
        "diagnostics": true,
        "include_code_artifacts": true
      },
      "expect": [
        {
          "type": "contains",
          "value": "MAX_RETRIES (Variable)"
        }
      ]
    },
    {
      "id": "G-PATH-03",
      "guard": "fallback files (SQL) have file entities \u2014 path queries reach them",
      "tool": "search",
      "args": {
        "query": "src/schema.sql",
        "limit": 5,
        "diagnostics": true,
        "include_chunks": false
      },
      "expect": [
        {
          "type": "regex",
          "value": "(?m)^src/schema\\.sql \\(File\\) \u2014 "
        }
      ]
    },
    {
      "id": "G-ALIAS-01",
      "guard": "import-alias callers link to the original symbol",
      "tool": "symbol_context",
      "args": {
        "symbol": "_tokens"
      },
      "expect": [
        {
          "type": "contains",
          "value": "TestModernTokenizer::test_gamma"
        }
      ]
    },
    {
      "id": "G-EVID-01",
      "guard": "EN-13/8: navigation surfaces resolved vs unresolved evidence",
      "tool": "symbol_context",
      "args": {
        "symbol": "cmd_gate"
      },
      "expect": [
        {
          "type": "contains",
          "value": "evidence callees"
        },
        {
          "type": "contains",
          "value": "unresolved: [json.dumps"
        }
      ]
    },
    {
      "id": "G-HOP-01",
      "guard": "EN-12: impact carries hop distances",
      "tool": "change_impact",
      "args": {
        "target": "_check_reviewer_independence"
      },
      "expect": [
        {
          "type": "contains",
          "value": "caller_hops"
        },
        {
          "type": "regex",
          "value": "\\(\"ValidatorRunner::check\", 1\\)"
        }
      ]
    }
  ]
}