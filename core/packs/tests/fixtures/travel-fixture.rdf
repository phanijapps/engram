<?xml version="1.0" encoding="utf-8"?>
<!-- Committed fixture pack (RDF/XML leg): a small schema.org-shaped travel
     vocabulary. Builder-owned test bytes for core/packs converter tests
     (TASK-006); the RDF/XML mirror of the Turtle leg's structure. -->
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:travel="https://fixture.example/travel/">

  <owl:Ontology rdf:about="https://fixture.example/travel/">
    <rdfs:label>Fixture travel vocabulary</rdfs:label>
  </owl:Ontology>

  <owl:Class rdf:about="https://fixture.example/travel/LodgingBusiness">
    <rdfs:label>Lodging Business</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="https://fixture.example/travel/Hotel">
    <rdfs:label>Hotel</rdfs:label>
    <rdfs:comment>A place offering rooms to travelers.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://fixture.example/travel/LodgingBusiness"/>
  </owl:Class>

  <owl:Class rdf:about="https://fixture.example/travel/Resort">
    <rdfs:label>Resort</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://fixture.example/travel/Hotel"/>
  </owl:Class>

  <owl:Class rdf:about="https://fixture.example/travel/Flight">
    <rdfs:label>Flight</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="https://fixture.example/travel/TouristAttraction">
    <rdfs:label>Tourist Attraction</rdfs:label>
  </owl:Class>

  <owl:ObjectProperty rdf:about="https://fixture.example/travel/provider">
    <rdfs:label>provider</rdfs:label>
    <rdfs:domain rdf:resource="https://fixture.example/travel/Flight"/>
    <rdfs:range rdf:resource="https://fixture.example/travel/LodgingBusiness"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://fixture.example/travel/nearbyAttraction">
    <rdfs:label>nearby attraction</rdfs:label>
    <rdfs:domain rdf:resource="https://fixture.example/travel/Hotel"/>
    <rdfs:range rdf:resource="https://fixture.example/travel/TouristAttraction"/>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="https://fixture.example/travel/nightlyRate">
    <rdfs:label>nightly rate</rdfs:label>
    <rdfs:domain rdf:resource="https://fixture.example/travel/Hotel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>

</rdf:RDF>
