{
  "name": "@engram/runtime",
  "version": "0.1.0",
  "description": "TS operational layer: deployable modules (ingest / maintenance / mcp) over the held Engram provider facade.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "engram-ingest": "./dist/ingest/bin.js",
    "engram-mcp-http": "./dist/mcp/bin.js",
    "engram-maintain": "./dist/maintenance/bin.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "@engram/contracts": "workspace:*",
    "@engram/node": "workspace:*",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0"
  }
}
