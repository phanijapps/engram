            "kind": "owner_reply",
            "text": "Email only, off by default. Success is that the chosen email setting survives restart. Keep SMS and backend behavior unchanged. Naming and layout are delegated; no implementation until the brief is agreed."
          },
          {
            "trigger": "concrete brief is presented for ratification",
            "kind": "owner_reply",
            "text": "I approve this brief only. Implementation Start and Finish are not granted."
          }
        ],
