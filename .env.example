# engram-cc + engram-mcp-http + pi-mono maintenance — local dev config TEMPLATE.
# Copy to `.env` and edit. Sourced by engram-cc/dev.sh and mcp/dev.sh (with
# `set -a`) on start, so the BFF, the MCP server, and the spawned engram-maintain
# child all inherit these. `.env` is gitignored; this file is committed.

# === LLM (engram-maintain reflect-llm / contradict-llm) =====================
# PI_PROVIDER: anthropic | ollama | openai  (default anthropic)
# Ollama = LOCAL, no key, no cloud egress (`ollama pull <model>` first).
# Anthropic/OpenAI = cloud (set the matching _API_KEY).
PI_PROVIDER=ollama
PI_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# PI_DRY_RUN=1            # token-free fixture responses (tests / offline)

# === engram store (shared by the BFF + MCP) =================================
ENGRAM_STORAGE=~/.engram/agentzero   # the dir holding engram_data.db
ENGRAM_DB_FILE=engram_data.db
ENGRAM_TENANT=default
ENGRAM_WORKSPACE=agentzero

# === engram-cc BFF (Hono on :3001) ==========================================
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENGRAM_MIGRATION_MODE=DryRun      # DryRun (read existing store) | Apply
ENGRAM_ENABLE_VECTOR=false        # true constructs the configured embedding provider

# === embedding provider (MCP + vector-enabled BFF) ==========================
# Defaults: FastEmbed BGE Small EN v1.5, 384 dimensions. Commented examples do
# not override a TOML profile. CLI flags override env; env overrides profile.
# See docs/guides/reference/embedding-models.md for all options and constraints.
# ENGRAM_EMBEDDING_CONFIG=/absolute/path/to/embedding.toml  # MCP profile only
# ENGRAM_EMBEDDING_PRESET=default
# Presets: default | local-alternative | multilingual | code-evaluation
# ENGRAM_EMBEDDING_PROVIDER=fastembed    # fastembed | ollama | openai-compatible
# ENGRAM_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# ENGRAM_EMBEDDING_DIMENSIONS=384       # omit for native/observed model size
# ENGRAM_EMBEDDING_ENDPOINT=http://localhost:11434  # served provider only
# ENGRAM_EMBEDDING_API_KEY_ENV=ENGRAM_MODEL_TOKEN  # variable NAME, not its value
# ENGRAM_EMBEDDING_QUERY_INSTRUCTION=""
# ENGRAM_EMBEDDING_PASSAGE_INSTRUCTION=""
# ENGRAM_EMBEDDING_TIMEOUT_SECS=30
# ENGRAM_EMBEDDING_BATCH_SIZE=32
# Provision served models separately. Remote endpoints require HTTPS.
# Changing model/space requires reindexing or a new store; no automatic wipe.

# === engram-mcp-http (loopback :8788) =======================================
MCP_PORT=8788
MCP_HOST=127.0.0.1                # 0.0.0.0 requires MCP_AUTH_TOKEN
MCP_ONTOLOGY=~/.engram/agentzero-ontology.json
MCP_TAXONOMY=~/.engram/agentzero-taxonomy.json
# Sample ontology JSON (create the file above with this shape):
#   {
#     "layers": [
#       {"name": "technical", "classes": ["Module", "Function", "Struct", "Store", "Adapter"]},
#       {"name": "domain", "classes": ["Agent", "Memory", "Belief", "Goal", "Procedure"]},
#       {"name": "business", "classes": ["Workflow", "Task", "Service"]}
#     ],
#     "predicates": {
#       "within": ["depends_on", "implements", "contains", "uses"],
#       "across": ["describes", "governs", "realized_by"]
#     }
#   }
# Sample taxonomy JSON (SKOS-style concept tree):
#   {
#     "name": "my-project",
#     "concepts": [
#       {"label": "System"},
#       {"label": "Code", "broader": "System"},
#       {"label": "Knowledge", "broader": "System"},
#       {"label": "Memory", "broader": "Knowledge"}
#     ]
#   }
# MCP_AUTH_TOKEN=...              # required ONLY if MCP_HOST is non-loopback
# MCP_TLS_CERT=...                # optional HTTPS (together with MCP_TLS_KEY)
# MCP_TLS_KEY=...
