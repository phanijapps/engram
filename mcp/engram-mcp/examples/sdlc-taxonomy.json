    { "label": "Tests",             "broader": "Source Code" },
    { "label": "Dependencies",      "broader": "Source Code" },
    { "label": "Documentation",     "broader": "Software Development" },
    { "label": "Architecture",      "broader": "Documentation" },
    { "label": "Process",           "broader": "Software Development" },
    { "label": "Requirements",      "broader": "Process" },
    { "label": "Backlog",           "broader": "Process" },
    { "label": "Delivery",          "broader": "Process" },
    { "label": "CI-CD",             "broader": "Delivery" },
    { "label": "Releases",          "broader": "Delivery" },
    { "label": "Incidents",         "broader": "Delivery" }
  ]
