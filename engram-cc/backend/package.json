{
  "name": "engram-cc-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "engram-cc Backend-for-Frontend: reads engram in-process via @engram/node (never engram-mcp for the browser) and exposes a keyset/aggregated REST surface.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@engram/contracts": "workspace:*",
    "@engram/node": "workspace:*",
    "@engram/runtime": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
